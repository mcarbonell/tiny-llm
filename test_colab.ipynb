   "source": [
    "def fibonacci(n):\n",
    "    fib_seq = [0, 1]\n",
    "    for _ in range(n - 2):\n",
    "        fib_seq.append(fib_seq[-1] + fib_seq[-2])\n",
    "    return fib_seq[:n]\n",
    "\n",
    "print(fibonacci(20))"
   ]
  }
